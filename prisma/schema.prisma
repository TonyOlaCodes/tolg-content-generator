generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlatformRole {
  USER
  PLATFORM_ADMIN
}

enum MemberRole {
  OWNER
  STAFF
}

enum BusinessType {
  MOBILE
  PREMISES
  BOTH
}

enum Industry {
  CAR_DETAILING
  CLEANING
  MOBILE_MECHANICS
  BARBERS_SALONS
  GARDEN_MAINTENANCE
  WINDOW_CLEANING
  OTHER
}

enum EnquiryStatus {
  NEW
  AWAITING_RESPONSE
  CONTACTED
  QUOTED
  BOOKED
  CLOSED
  LOST
}

enum EnquirySource {
  BOOKING_PAGE
  DEMO
  MANUAL
  WEBSITE
  PHONE
  WHATSAPP
  INSTAGRAM
  EMAIL
  OTHER
}

enum AppointmentStatus {
  REQUESTED
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum AppointmentLocationType {
  MOBILE
  PREMISES
}

enum NotificationChannel {
  EMAIL
  SMS
  WHATSAPP
  INTERNAL
}

enum NotificationStatus {
  PREVIEWED
  QUEUED
  SENT
  FAILED
}

enum SubscriptionPlan {
  STARTER
  GROWTH
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
  NONE
}

enum AutomationKind {
  OWNER_NEW_ENQUIRY
  OWNER_UNANSWERED_REMINDER
  CUSTOMER_APPOINTMENT_REMINDER
  QUOTE_FOLLOW_UP_FLAG
}

model User {
  id             String       @id @default(cuid())
  name           String?
  email          String       @unique
  emailVerified  DateTime?
  image          String?
  passwordHash   String?
  platformRole   PlatformRole @default(USER)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  accounts       Account[]
  sessions       Session[]
  memberships    BusinessMember[]
  assignedEnquiries Enquiry[] @relation("EnquiryAssignee")
  assignedAppointments Appointment[] @relation("AppointmentAssignee")
  auditLogs      AuditLog[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Business {
  id              String       @id @default(cuid())
  name            String
  slug            String       @unique
  industry        Industry     @default(CAR_DETAILING)
  email           String
  phone           String?
  county          String?
  city            String?
  address         String?
  businessType    BusinessType @default(MOBILE)
  timezone        String       @default("Europe/Dublin")
  brandingColor   String       @default("#C9A227")
  logoUrl         String?
  isDemo          Boolean      @default(false)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  members         BusinessMember[]
  services        Service[]
  customers       Customer[]
  enquiries       Enquiry[]
  appointments    Appointment[]
  availability    AvailabilityRule[]
  automations     AutomationRule[]
  notifications   Notification[]
  subscription    Subscription?
  settings        BusinessSettings?
  auditLogs       AuditLog[]
}

model BusinessSettings {
  id                    String   @id @default(cuid())
  businessId            String   @unique
  notifyOwnerOnEnquiry  Boolean  @default(true)
  ackCustomerOnEnquiry  Boolean  @default(true)
  sendBookingConfirm    Boolean  @default(true)
  sendReminders         Boolean  @default(true)
  bufferMinutes         Int      @default(15)
  depositEnabled        Boolean  @default(false)
  operatingHoursJson    Json
  intakeFieldsJson      Json?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  business              Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model BusinessMember {
  id         String     @id @default(cuid())
  businessId String
  userId     String
  role       MemberRole @default(STAFF)
  createdAt  DateTime   @default(now())
  business   Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([businessId, userId])
  @@index([userId])
}

model Service {
  id              String   @id @default(cuid())
  businessId      String
  name            String
  description     String?
  durationMinutes Int      @default(60)
  priceCents      Int?
  currency        String   @default("EUR")
  isActive        Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  business        Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  enquiries       Enquiry[]
  appointments    Appointment[]

  @@index([businessId, isActive])
}

model Customer {
  id         String   @id @default(cuid())
  businessId String
  name       String
  email      String?
  phone      String?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  vehicles   CustomerVehicle[]
  enquiries  Enquiry[]
  appointments Appointment[]

  @@index([businessId, email])
  @@index([businessId, name])
}

model CustomerVehicle {
  id         String   @id @default(cuid())
  customerId String
  make       String?
  model      String?
  size       String?
  condition  String?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model Enquiry {
  id              String        @id @default(cuid())
  businessId      String
  customerId      String
  serviceId       String?
  assigneeId      String?
  source          EnquirySource @default(BOOKING_PAGE)
  status          EnquiryStatus @default(NEW)
  message         String?
  preferredDate   DateTime?
  preferredTime   String?
  locationType    AppointmentLocationType?
  locationText    String?
  intakeJson      Json?
  nextFollowUpAt  DateTime?
  lastContactAt   DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  business        Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer        Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  service         Service?      @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  assignee        User?         @relation("EnquiryAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  activities      EnquiryActivity[]
  appointments    Appointment[]

  @@index([businessId, status, createdAt])
  @@index([businessId, nextFollowUpAt])
}

model EnquiryActivity {
  id         String   @id @default(cuid())
  enquiryId  String
  actorUserId String?
  type       String
  body       String?
  metaJson   Json?
  createdAt  DateTime @default(now())
  enquiry    Enquiry  @relation(fields: [enquiryId], references: [id], onDelete: Cascade)

  @@index([enquiryId, createdAt])
}

model Appointment {
  id              String                   @id @default(cuid())
  businessId      String
  customerId      String
  serviceId       String?
  enquiryId       String?
  assigneeId      String?
  status          AppointmentStatus        @default(REQUESTED)
  startsAt        DateTime
  endsAt          DateTime
  locationType    AppointmentLocationType?
  locationText    String?
  notes           String?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  business        Business                 @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer        Customer                 @relation(fields: [customerId], references: [id], onDelete: Cascade)
  service         Service?                 @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  enquiry         Enquiry?                 @relation(fields: [enquiryId], references: [id], onDelete: SetNull)
  assignee        User?                    @relation("AppointmentAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([businessId, startsAt])
  @@index([businessId, status])
  @@index([assigneeId, startsAt, endsAt])
}

model AvailabilityRule {
  id         String   @id @default(cuid())
  businessId String
  dayOfWeek  Int
  startTime  String
  endTime    String
  isClosed   Boolean  @default(false)
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, dayOfWeek])
}

model AutomationRule {
  id          String         @id @default(cuid())
  businessId  String
  kind        AutomationKind
  enabled     Boolean        @default(true)
  delayMinutes Int           @default(0)
  configJson  Json?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  business    Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  executions  AutomationExecution[]

  @@unique([businessId, kind])
}

model AutomationExecution {
  id          String   @id @default(cuid())
  ruleId      String
  idempotencyKey String @unique
  status      String
  detail      String?
  createdAt   DateTime @default(now())
  rule        AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
}

model Notification {
  id          String              @id @default(cuid())
  businessId  String
  channel     NotificationChannel @default(EMAIL)
  eventType   String
  recipient   String
  subject     String?
  body        String
  status      NotificationStatus  @default(PREVIEWED)
  error       String?
  metaJson    Json?
  createdAt   DateTime            @default(now())
  business    Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt])
}

model Subscription {
  id                   String             @id @default(cuid())
  businessId           String             @unique
  plan                 SubscriptionPlan   @default(STARTER)
  status               SubscriptionStatus @default(NONE)
  stripeCustomerId     String?
  stripeSubscriptionId String?
  setupFeeCents        Int                @default(14900)
  currentPeriodEnd     DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  business             Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id         String   @id @default(cuid())
  businessId String?
  actorUserId String?
  action     String
  targetType String?
  targetId   String?
  metaJson   Json?
  createdAt  DateTime @default(now())
  business   Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  actor      User?     @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([businessId, createdAt])
  @@index([actorUserId, createdAt])
}

model ContactRequest {
  id        String   @id @default(cuid())
  name      String
  email     String
  business  String?
  message   String
  createdAt DateTime @default(now())
}
