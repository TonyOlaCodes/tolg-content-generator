# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Auth.js
AUTH_SECRET="generate-with-openssl-rand-base64-32"
ENCRYPTION_SECRET="generate-a-separate-secret"

# Seed user (single-user auth)
SEED_USER_EMAIL="admin@tolg.local"
SEED_USER_PASSWORD="tolg-admin-change-me"

# Vercel Blob (required for media upload)
# Created via: npx vercel blob create-store tolg-media --access public --yes
BLOB_READ_WRITE_TOKEN=""

# OpenAI (optional — app works with fallback hooks when unset)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# TikTok Content Posting API (optional — UI disables publish when unset)
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
TIKTOK_REDIRECT_URI="http://localhost:3000/api/tiktok/callback"

# Isolated video render worker (Phase 4)
RENDER_WORKER_URL="http://localhost:4001"
RENDER_WORKER_SECRET="shared-worker-secret"

# App
NEXTAUTH_URL="http://localhost:3000"
AUTH_URL="http://localhost:3000"
