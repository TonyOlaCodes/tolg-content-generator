# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
# Optional direct URL for migrations if using a pooled Neon URL
# DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Auth.js
AUTH_SECRET="generate-with-openssl-rand-base64-32"
# Optional: used to encrypt ExternalConnection secrets (falls back to AUTH_SECRET)
ENCRYPTION_SECRET="generate-a-separate-secret"

# Seed user (single-user auth)
SEED_USER_EMAIL="admin@tolg.local"
SEED_USER_PASSWORD="tolg-admin-change-me"

# Cloudinary (required for media upload)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# OpenAI (optional — app works with fallback hooks when unset)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# TikTok Content Posting API (optional — UI disables publish when unset)
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
TIKTOK_REDIRECT_URI="http://localhost:3000/api/tiktok/callback"

# Isolated video render worker (Phase 4)
RENDER_WORKER_URL="http://localhost:4001"
RENDER_WORKER_SECRET="shared-worker-secret"

# App
NEXTAUTH_URL="http://localhost:3000"
AUTH_URL="http://localhost:3000"
