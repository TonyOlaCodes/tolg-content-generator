# Copy to .env for local overrides. Every value here is optional.

# Where the browser should look for the game socket when it is NOT the same origin
# as the page. Leave blank for the all-in-one server (npm run dev / npm start / Docker).
# Example: NEXT_PUBLIC_GAME_SERVER_URL=https://elephant-game.onrender.com
NEXT_PUBLIC_GAME_SERVER_URL=

# All-in-one server (npm run dev, npm start): default 3000
# Standalone game server (npm run server): default 3001
# Hosts like Render set PORT themselves.
PORT=3000

# Bind address for the all-in-one server. Default 0.0.0.0 so phones can reach it.
HOSTNAME=0.0.0.0
