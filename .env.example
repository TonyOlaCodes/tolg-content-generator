# PostgreSQL (Neon pooled URL in production)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Auth.js
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
DEMO_BUSINESS_SLUG="cleancar-demo"
PLATFORM_ADMIN_EMAIL="admin@detailflow.ie"

# Pricing (EUR, editable — not claimed as validated)
PLAN_STARTER_EUR="79"
PLAN_GROWTH_EUR="149"
SETUP_FEE_EUR="149"

# Resend (optional — without it, emails are preview-logged only)
RESEND_API_KEY=""
EMAIL_FROM="DetailFlow <onboarding@resend.dev>"

# Stripe (optional — test mode; billing UI works without live charges)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_GROWTH=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
